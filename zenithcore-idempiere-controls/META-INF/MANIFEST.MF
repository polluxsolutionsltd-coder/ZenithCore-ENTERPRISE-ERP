Manifest-Version: 1.0
Bundle-ManifestVersion: 2
Bundle-Name: ZenithCore Controls for iDempiere
Bundle-SymbolicName: ke.co.pollux.zenithcore.controls.idempiere;singleton:=true
Bundle-Version: 0.1.0.qualifier
Bundle-Vendor: Pollux Solutions Ltd
Bundle-RequiredExecutionEnvironment: JavaSE-17
Require-Capability: osgi.ee;filter:="(&(osgi.ee=JavaSE)(version>=17))"
Require-Bundle: org.adempiere.base;bundle-version="13.0.0"
Import-Package: com.google.zxing;version="[3.4.0,4.0.0)",
 com.google.zxing.common;version="[3.4.0,4.0.0)",
 com.google.zxing.qrcode;version="[3.4.0,4.0.0)",
 com.google.zxing.qrcode.decoder;version="[3.4.0,4.0.0)",
 com.lowagie.text;version="[1.3.0,2.0.0)",
 com.lowagie.text.pdf;version="[1.3.0,2.0.0)",
 ke.co.pollux.zenithcore.controls;version="[0.1.0,1.0.0)",
 org.osgi.framework,
 org.osgi.service.event
Bundle-ActivationPolicy: lazy
Bundle-ClassPath: .
Automatic-Module-Name: ke.co.pollux.zenithcore.controls.idempiere
